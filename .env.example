# Local development settings. Copy this file to .env before using Docker Compose.
DB_NAME=medical_drone_db
DB_PORT=3306
DB_PASSWORD=radhika@1234
JWT_SECRET=change-this-local-jwt-secret-to-a-random-value-at-least-32-characters
REDIS_HOST=localhost
REDIS_PORT=6379
AI_SERVICE_URL=http://localhost:8000
# Docker network endpoints; override these when using external services.
DOCKER_DB_HOST=mysql
DOCKER_REDIS_HOST=redis
DOCKER_AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_WORKFLOW_TIMEOUT_SECONDS=30
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_TIMEOUT_SECONDS=5
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=MedicalDroneManagement/1.0 (contact: 1da23cs167.cs@drait.edu.in)

# Optional integrations. Core weather uses Open-Meteo and needs no key.
GROQ_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
